# Machine-specific paths. Copy to locals.txt and fill in. Never committed.
#
# Where nielsoln_agent_standards is cloned, so update_agents.py can find the
# generator. Relative paths resolve against this repo's root.
AGENT_STANDARDS_DIR = ..\nielsoln_agent_standards

# Interpreter used by linkprobe to drive the Excel routes through COM.
# Needs pywin32.
VENV_PYTHON = "<venv>\Scripts\python.exe"
